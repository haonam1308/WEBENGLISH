@model EnglishWeb.Models.UserVocabularyHistory
@{
    ViewBag.Title = "Flashcard Review";
    var word = ViewBag.CurrentFlashcard as EnglishWeb.Models.UserVocabularyHistory;
    bool showMeaning = ViewBag.ShowMeaning ?? false;
    int totalWords = ViewBag.WordsToReviewCount ?? 0;
}

<div class="container">
    <h2>Flashcard Review</h2>
    <a href="@Url.Action("AddNewWord", "Flashcard")" class="btn btn-outline-success mb-3">➕ Add New Word</a>


    @if (word != null)
    {
        <div class="card mt-4 p-4 border shadow-sm">
            <h3>@word.Vocabulary.Word</h3>

            @if (showMeaning)
            {
                <p><strong>Meaning:</strong> @word.Vocabulary.Definition</p> <!-- Cập nhật đúng trường Meaning -->

                <form method="post" action="@Url.Action("RateWord", "Flashcard")">
                    <input type="hidden" name="historyId" value="@word.HistoryId" />
                    <input type="hidden" name="wordId" value="@word.WordId" />
                    <div class="rating">
                        <label>Rate your memory (0-5):</label><br />
                        @for (int i = 0; i <= 5; i++)
                        {
                            <button type="submit" name="rating" value="@i" class="btn btn-outline-primary m-1">@i</button>
                        }
                    </div>
                </form>
            }
            else
            {
                <form method="post" action="@Url.Action("ShowMeaning", "Flashcard")">
                    <input type="hidden" name="historyId" value="@word.HistoryId" />
                    <input type="hidden" name="wordId" value="@word.WordId" />
                    <button type="submit" class="btn btn-success">Show Meaning</button>
                </form>
            }

            <!-- Nếu là từ mới (chưa có trong flashcard) thì hiển thị nút thêm -->
            @if (word.HistoryId == 0)
            {
                <form method="post" action="@Url.Action("AddToFlashcard", "Flashcard")" class="mt-3">
                    <input type="hidden" name="wordId" value="@word.WordId" />
                    <button type="submit" class="btn btn-warning">➕ Add to My Flashcard</button>
                </form>
            }
        </div>

        <p class="mt-3">Remaining words to review: <strong>@totalWords</strong></p>
    }
    else
    {
        <div class="alert alert-info">🎉 You have completed all reviews!</div>
    }

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning mt-3">@ViewBag.Message</div>
    }
</div>
